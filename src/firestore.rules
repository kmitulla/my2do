// ════════════════════════════════════════════════════════
//  FIRESTORE SECURITY RULES – 2Do App  (Version 0.4)
//  → Kopiere diese Rules in die Firebase Console:
//    Firebase Console → Firestore → Rules
//
//  NEU in 0.4 (Sicherheit):
//  - Normale User können ihre eigene Rolle nicht mehr ändern. Vorher konnte
//    sich jeder eingeloggte User selbst role = "admin" geben (die Regel für
//    private Daten traf über {document=**} auch das Profil-Dokument selbst).
//  - Geteilte 2dos können nur im eigenen Namen angelegt werden.
//  Die App funktioniert auch mit Version 0.3 – 0.4 schließt nur die Lücken.
//
//  0.3: Admins (role == "admin" im eigenen users-Dokument) dürfen alle
//  users/{userId}-Dokumente lesen, ändern und löschen.
// ════════════════════════════════════════════════════════

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Ist der anfragende User ein Admin?
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ── User-Profil-Dokument (users/{userId}) ────────────────────────────────
    // Owner: lesen, anlegen (nur als "user"), ändern – aber nie die Rolle
    // Admin: lesen (inkl. Liste), ändern (auch Rollen), löschen
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'user'));
      allow update: if isAdmin() || (isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isAdmin();
    }

    // ── User private data (todos, categories, settings, notebooks, minimized)
    // Bewusst {collection}/{document=**}: ein nacktes {document=**} würde in
    // Rules-Version 2 auch das Profil-Dokument users/{userId} selbst treffen
    // und die Rollen-Sperre oben aushebeln.
    match /users/{userId}/{collection}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Public user profiles (for sharing feature) ──────────────────────────
    // Every authenticated user can read all profiles (to find users to share with)
    // Only the owner can write their own profile
    match /userProfiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Geteilte 2dos (Mitbearbeitung) ──────────────────────────────────────
    // Anlegen nur im eigenen Namen (sharedBy = man selbst, selbst Mitglied).
    // Lesen/Ändern: Absender, Mitbearbeiter (collaborators) und alle je
    // Eingeladenen (targetUids – nötig für "Rückgängig" nach dem Verlassen).
    match /sharedTodos/{todoId} {
      allow create: if request.auth != null &&
        request.resource.data.sharedBy == request.auth.uid &&
        request.auth.uid in request.resource.data.collaborators;
      allow read: if request.auth != null && (
        resource.data.sharedBy == request.auth.uid ||
        request.auth.uid in resource.data.collaborators ||
        request.auth.uid in resource.data.targetUids
      );
      allow update: if request.auth != null && (
        resource.data.sharedBy == request.auth.uid ||
        request.auth.uid in resource.data.collaborators ||
        request.auth.uid in resource.data.targetUids
      ) && request.resource.data.sharedBy == resource.data.sharedBy;
    }
  }
}
